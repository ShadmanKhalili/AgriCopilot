# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Daily Limits & Model Configuration
# Guests (no sign-in, or an email address that was never verified) can be
# created in bulk, so they get a small allowance. Linking Google lifts it.
AI_GUEST_DAILY_LIMIT=10
AI_FREE_DAILY_LIMIT=100
AI_PREMIUM_DAILY_LIMIT=1000
AI_TEXT_MODELS="gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash,gemini-3.5-flash-lite"

# Live video / voice sessions. Each session also counts against the daily
# limit above; these cap how many live sessions an account may start per day.
AI_GUEST_DAILY_LIVE_SESSIONS=1
AI_FREE_DAILY_LIVE_SESSIONS=20
AI_PREMIUM_DAILY_LIVE_SESSIONS=200
# How long one live session may run (minutes, 1-60).
AI_LIVE_SESSION_MINUTES=15
# Live models a session token may be locked to.
AI_LIVE_MODELS="gemini-3.8-live,gemini-3.8-live-extended-thinking"

# Paid lookups one address may make per minute. Answers from the cache do not count.
WEATHER_MAX_CALLS_PER_IP_PER_MINUTE=60
SENTINEL_MAX_CALLS_PER_IP_PER_MINUTE=30

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: Required for weather data.
# Get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Copernicus Data Space Ecosystem Credentials (Free Sentinel-2 Data)
# Get them at https://dataspace.copernicus.eu/ (Dashboard -> User Settings -> OAuth Clients)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Agromonitoring API Key (Satellite Imagery)
# Get one at https://agromonitoring.com/
AGROMONITORING_API_KEY=

# Google Maps Platform Weather API (optional)
# Enables live Google Weather API data and the interactive farm map.
# NOTE: VITE_* values are embedded in the client bundle; restrict the key by HTTP referrer.
# The live forecast spends a SERVER-side key only, looked up in this order:
# GOOGLE_WEATHER_API_KEY, GOOGLE_MAPS_API_KEY, GOOGLE_API_KEY, MAPS_API_KEY.
# VITE_GOOGLE_MAPS_API_KEY is never used by the server: if only that one is
# set, the app serves the free Open-Meteo forecast instead.
GOOGLE_WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Google AdSense
# VITE_ENABLE_ADS=false to disable ads globally
VITE_ENABLE_ADS=true
VITE_ADSENSE_CLIENT_ID=ca-pub-8691248886116699
VITE_ADSENSE_SLOT_ID=

# Phase 6: area reports and phone notifications
# Server only: the Firebase service-account key JSON, or its base64. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT=
# Optional: Firestore database ID. Leave empty to use the app's default database.
FIRESTORE_DATABASE_ID=
# Server only: web-push (VAPID) public key, base64url.
VAPID_PUBLIC_KEY=
# Server only: web-push (VAPID) private key, base64url. Keep it secret.
VAPID_PRIVATE_KEY=
# Server only: contact for push services, in the form mailto:you@example.com
VAPID_SUBJECT=
# Browser: same value as VAPID_PUBLIC_KEY. Built into the app, so redeploy after changing it.
VITE_VAPID_PUBLIC_KEY=

# Abuse protection for the AI endpoints (all OFF until set). See docs/APP_CHECK_SETUP.md.
# Browser: reCAPTCHA Enterprise site key registered for this web app in Firebase App Check.
# Built into the app, so redeploy after changing it. Empty = App Check is not used.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Server: the Firebase project NUMBER (Project settings > General), not the project id.
APP_CHECK_PROJECT_NUMBER=
# Server: off (default) | monitor (verify and log failures, allow) | enforce (refuse with 401 app_check).
APP_CHECK_MODE=off
# Server: most AI calls the whole app will serve per Dhaka day (text, audio and live sessions together).
# When reached, the AI proxy answers 503 daily_capacity until the next day. Empty = no cap.
# Needs FIREBASE_SERVICE_ACCOUNT (counter lives in Firestore at aiUsageGlobal/<YYYY-MM-DD>).
AI_GLOBAL_DAILY_CALL_CAP=
