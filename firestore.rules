rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Zero-Trust Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Shared Security Primitives & Guards
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == "sadmankhalili@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isStr(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isTimestamp(val) {
      return val is string && val.size() >= 19 && val.size() <= 50;
    }

    // The email stored on a profile must be the one the Firebase ID token
    // carries, so a user cannot write somebody else's address onto their own
    // profile. Anonymous sessions have no `email` claim at all; their only
    // accepted value is the local `guest-…@agri.local` placeholder.
    function isEmailBoundToAuth(email) {
      return (request.auth.token.email != null && email == request.auth.token.email) ||
             (request.auth.token.email == null && isStr(email, 1, 128) && email.matches('^guest-[a-z0-9]{1,64}@agri\\.local$'));
    }

    // ===============================================================
    // Entity Schema Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'tier', 'usageCount', 'createdAt']) &&
             // Close the schema: without this a write could smuggle in extra
             // fields (custom claims, flags, anything) that later code might
             // start trusting.
             data.keys().hasOnly(['uid', 'email', 'name', 'role', 'tier', 'usageCount', 'lastUsedDate', 'createdAt', 'updatedAt', 'expertLevel', 'orgId']) &&
             isStr(data.uid, 1, 128) &&
             isStr(data.email, 3, 128) &&
             data.role in ['agri-preneur', 'hub-manager', 'admin', 'expert_pending', 'expert', 'org_admin'] &&
             data.tier in ['free', 'premium', 'anon'] &&
             data.usageCount is number && data.usageCount >= 0 &&
             isTimestamp(data.createdAt);
    }

    function isValidDiagnosis(data) {
      return data.keys().hasAll(['userId', 'crop', 'cropStage', 'analysisType', 'diagnosisText', 'qualitativeSeverity', 'symptomsBreakdown', 'verificationAdvice', 'createdAt']) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.crop, 1, 128) &&
             isStr(data.cropStage, 1, 128) &&
             isStr(data.analysisType, 1, 64) &&
             isStr(data.diagnosisText, 1, 30000) &&
             data.qualitativeSeverity in ['Low', 'Medium', 'High'] &&
             data.symptomsBreakdown is list &&
             data.symptomsBreakdown.size() <= 25 &&
             isStr(data.verificationAdvice, 1, 10000) &&
             isTimestamp(data.createdAt);
    }

    function isValidCertificate(data) {
      let requiredFields = ['userId', 'produce', 'grade', 'justification', 'estimatedPriceBdt', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.produce, 1, 128) &&
             isStr(data.grade, 1, 64) &&
             isStr(data.justification, 1, 5000) &&
             data.estimatedPriceBdt is number && data.estimatedPriceBdt >= 0 &&
             isTimestamp(data.createdAt);
    }

    function isValidAlert(data) {
      let requiredFields = ['userId', 'scenario', 'message', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.scenario, 1, 256) &&
             isStr(data.message, 1, 5000) &&
             isTimestamp(data.createdAt);
    }

    function isValidMarketQuery(data) {
      let requiredFields = ['userId', 'produce', 'insights', 'isAdvanced', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.produce, 1, 128) &&
             isStr(data.insights, 1, 10000) &&
             data.isAdvanced is bool &&
             isTimestamp(data.createdAt);
    }

    function isValidPlantingIntent(data) {
      let requiredFields = ['userId', 'latitude', 'longitude', 'landType', 'landSize', 'irrigation', 'previousCrop', 'budget', 'targetTime', 'recommendedCrop', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             isStr(data.userId, 1, 128) &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             isStr(data.landType, 1, 128) &&
             isStr(data.landSize, 1, 128) &&
             isStr(data.irrigation, 1, 128) &&
             isStr(data.previousCrop, 1, 128) &&
             isStr(data.budget, 1, 128) &&
             isStr(data.targetTime, 1, 128) &&
             isStr(data.recommendedCrop, 1, 128) &&
             isTimestamp(data.createdAt);
    }

    function isValidFarmerProfile(data) {
      let requiredFields = ['userId', 'fullName', 'creditReadinessScore', 'updatedAt', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.fullName, 1, 128) &&
             data.creditReadinessScore is number && 
             data.creditReadinessScore >= 0 && data.creditReadinessScore <= 100 &&
             isTimestamp(data.updatedAt) &&
             isTimestamp(data.createdAt);
    }

    function isValidTimelineEvent(data) {
      let requiredFields = ['userId', 'eventType', 'title', 'summary', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             isStr(data.userId, 1, 128) &&
             data.eventType in ['voice_consultation', 'crop_diagnosis', 'weather_alert', 'smart_grading', 'market_mandi', 'planting_intent'] &&
             isStr(data.title, 1, 256) &&
             isStr(data.summary, 1, 10000) &&
             isTimestamp(data.createdAt);
    }

    // ===============================================================
    // Collection Rules & Attribute-Based Access Control (ABAC)
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // A profile is created exactly once, by its owner, with the free tier and
      // the farmer role baked in. `tier` used to be a self-service field, which
      // let any signed-in account PATCH itself to 'premium'.
      allow create: if isSignedIn() && isValidUser(incoming()) &&
                    incoming().uid == request.auth.uid &&
                    userId == request.auth.uid &&
                    isValidId(userId) &&
                    isEmailBoundToAuth(incoming().email) &&
                    (
                      (incoming().role == 'agri-preneur' && incoming().tier == 'free') ||
                      (isAdmin() && incoming().role == 'admin' && incoming().tier == 'premium')
                    );
      allow update: if isSignedIn() && isValidUser(incoming()) &&
                    (
                      // Admins may manage any profile (role/tier included)
                      (isAdmin() && incoming().uid == existing().uid) ||
                      // Users may update only their own non-privileged fields.
                      // `tier` and `role` are pinned to their current value:
                      // promoting an account to premium is a paid entitlement
                      // and must never be a self-service write.
                      (isOwner(userId) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().role == existing().role &&
                       incoming().tier == existing().tier &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['usageCount', 'lastUsedDate', 'name', 'updatedAt']))
                    );
      allow delete: if isAdmin();
    }

    // Digital Krishi Prescriptions (Rx) issued from the AI Crop Doctor.
    // Previously missing from this file, so every write fell through to the
    // global default-deny and silently fell back to localStorage.
    match /prescriptions/{prescriptionId} {
      function isValidPrescription(data) {
        return data.keys().hasAll(['rxId', 'userId', 'farmerName', 'crop', 'diseaseName', 'severity', 'confidence', 'location', 'createdAt', 'verified']) &&
               isStr(data.rxId, 1, 64) &&
               isStr(data.userId, 1, 128) &&
               isStr(data.farmerName, 1, 128) &&
               isStr(data.crop, 1, 128) &&
               isStr(data.diseaseName, 1, 256) &&
               isStr(data.severity, 1, 64) &&
               data.confidence is number && data.confidence >= 0 && data.confidence <= 100 &&
               isStr(data.location, 1, 256) &&
               isTimestamp(data.createdAt) &&
               data.verified is bool &&
               isValidId(prescriptionId);
      }

      // Farmers read their own Rx history; admins read the national audit registry.
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(prescriptionId);
      // Only a signed-in owner may file a prescription. The old rule also
      // accepted `userId == 'anonymous'` with no `isSignedIn()` check, which
      // let any anonymous caller inject rows into the national audit registry.
      allow create: if isSignedIn() &&
                    isValidPrescription(incoming()) &&
                    incoming().userId == request.auth.uid;
      allow update: if isAdmin() && isValidPrescription(incoming());
      allow delete: if isAdmin();
    }

    match /diagnoses/{diagnosisId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(diagnosisId);
      
      allow create: if isSignedIn() && isValidDiagnosis(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    isValidId(diagnosisId);
      
      allow update: if isSignedIn() && isValidDiagnosis(incoming()) &&
                    existing().userId == request.auth.uid &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    isValidId(diagnosisId) &&
                    (
                      isAdmin() ||
                      (
                        incoming().diff(existing()).affectedKeys().hasAny(['deepDiagnosis', 'deepDiagnosedAt', 'helpful', 'chatSummary']) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['deepDiagnosis', 'deepDiagnosedAt', 'helpful', 'chatSummary', 'updatedAt'])
                      )
                    );
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(certificateId);
      allow create: if isSignedIn() && isValidCertificate(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    isValidId(certificateId);
      allow delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(alertId);
      allow create: if isSignedIn() && isValidAlert(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    isValidId(alertId);
      allow delete: if isAdmin();
    }

    match /market_queries/{queryId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(queryId);
      allow create: if isSignedIn() && isValidMarketQuery(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    isValidId(queryId);
      allow delete: if isAdmin();
    }

    match /planting_intents/{intentId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(intentId);
      allow create: if isSignedIn() && isValidPlantingIntent(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    isValidId(intentId);
      allow delete: if isAdmin();
    }
    
    match /gov_schemes/{schemeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /farmer_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && isValidFarmerProfile(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    userId == request.auth.uid &&
                    isValidId(userId);
      allow update: if isSignedIn() && isValidFarmerProfile(incoming()) &&
                    isOwner(userId) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    isValidId(userId) &&
                    (
                      isAdmin() ||
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'fullName', 'creditReadinessScore', 'insuranceRiskTier', 
                        'primaryCrop', 'cropsGrown', 'totalLandDecimals', 
                        'locationDistrict', 'locationUpazila', 'soilType', 
                        'irrigationType', 'totalSessionsCompleted', 'totalDiagnoses', 
                        'lastInteractionSummary', 'lastInteractionDate', 'keyInsights', 'updatedAt'
                      ])
                    );
      allow delete: if isAdmin();
    }

    match /farmer_timeline_events/{eventId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(eventId);
      allow create: if isSignedIn() && isValidTimelineEvent(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    isValidId(eventId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Human Expert Layer (Phase 1 MVP)
    //
    // Farmers escalate from AI advice to a verified human expert. Privacy
    // is consent-first: an expert can only read a consultation (and its
    // messages) while the farmer's consent is valid, and loses access the
    // instant it is revoked or expires.
    // ===============================================================

    function isActiveExpert(expertId) {
      return get(/databases/$(database)/documents/experts_public/$(expertId)).data.status == 'active';
    }

    function isConsultationParticipant(consultationId) {
      let c = get(/databases/$(database)/documents/consultations/$(consultationId)).data;
      return isSignedIn() &&
        (c.farmerId == request.auth.uid ||
         (c.expertId == request.auth.uid &&
          c.consentRevoked == false &&
          c.consentExpiresAtMs > request.time.toMillis()));
    }

    function isConsultationFarmer(consultationId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/consultations/$(consultationId)).data.farmerId == request.auth.uid;
    }

    function isConsultationExpert(consultationId) {
      let c = get(/databases/$(database)/documents/consultations/$(consultationId)).data;
      return isSignedIn() &&
        c.expertId == request.auth.uid &&
        c.consentRevoked == false &&
        c.consentExpiresAtMs > request.time.toMillis();
    }

    function isValidExpertPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'affiliationType', 'affiliationName', 'roleTitle', 'districts', 'upazilas', 'specializations', 'languages', 'verificationLevel', 'status', 'ratingAverage', 'ratingCount', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'affiliationType', 'affiliationName', 'roleTitle', 'districts', 'upazilas', 'specializations', 'languages', 'bio', 'verificationLevel', 'status', 'ratingAverage', 'ratingCount', 'responseTimeMins', 'isDemo', 'createdAt', 'updatedAt']) &&
             isStr(data.uid, 1, 128) &&
             isStr(data.displayName, 1, 128) &&
             data.affiliationType in ['government', 'ngo', 'private', 'peer'] &&
             isStr(data.affiliationName, 0, 128) &&
             isStr(data.roleTitle, 1, 128) &&
             data.districts is list && data.districts.size() <= 64 &&
             data.upazilas is list && data.upazilas.size() <= 128 &&
             data.specializations is list && data.specializations.size() >= 1 && data.specializations.size() <= 16 &&
             data.languages is list && data.languages.size() <= 8 &&
             data.verificationLevel in ['provisional', 'verified', 'senior'] &&
             data.status in ['active', 'paused', 'suspended'] &&
             data.ratingAverage is number && data.ratingAverage >= 0 && data.ratingAverage <= 5 &&
             data.ratingCount is number && data.ratingCount >= 0 &&
             (!data.keys().hasAny(['bio']) || isStr(data.bio, 0, 1000)) &&
             (!data.keys().hasAny(['photoURL']) || isStr(data.photoURL, 0, 2000)) &&
             (!data.keys().hasAny(['responseTimeMins']) || (data.responseTimeMins is number && data.responseTimeMins >= 0 && data.responseTimeMins <= 10080)) &&
             isTimestamp(data.createdAt) &&
             isTimestamp(data.updatedAt);
    }

    function isValidExpertPrivate(data) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
             isStr(data.uid, 1, 128) &&
             isTimestamp(data.updatedAt) &&
             (!data.keys().hasAny(['phone']) || isStr(data.phone, 0, 24)) &&
             (!data.keys().hasAny(['email']) || isStr(data.email, 0, 128)) &&
             (!data.keys().hasAny(['availability']) || data.availability in ['online', 'offline', 'busy']);
    }

    function isValidExpertApplication(data) {
      return data.keys().hasAll(['applicantId', 'fullName', 'phone', 'affiliationType', 'affiliationName', 'roleTitle', 'districts', 'specializations', 'languages', 'yearsExperience', 'motivation', 'status', 'createdAt', 'updatedAt']) &&
             isStr(data.applicantId, 1, 128) &&
             isStr(data.fullName, 2, 128) &&
             isStr(data.phone, 6, 24) &&
             data.affiliationType in ['government', 'ngo', 'private', 'peer'] &&
             isStr(data.affiliationName, 0, 128) &&
             isStr(data.roleTitle, 2, 128) &&
             data.districts is list && data.districts.size() <= 64 &&
             data.specializations is list && data.specializations.size() >= 1 && data.specializations.size() <= 16 &&
             data.languages is list && data.languages.size() >= 1 && data.languages.size() <= 8 &&
             data.yearsExperience is number && data.yearsExperience >= 0 && data.yearsExperience <= 70 &&
             isStr(data.motivation, 10, 2000) &&
             (!data.keys().hasAny(['publicBio']) || isStr(data.publicBio, 0, 600)) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             isTimestamp(data.createdAt) &&
             isTimestamp(data.updatedAt);
    }

    function isValidConsultation(data) {
      return data.keys().hasAll(['farmerId', 'farmerName', 'expertId', 'expertName', 'status', 'urgency', 'category', 'lang', 'district', 'upazila', 'consentScope', 'consentGrantedAt', 'consentExpiresAt', 'consentExpiresAtMs', 'consentRevoked', 'requestedAt', 'slaDueAt', 'slaDueAtMs', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['farmerId', 'farmerName', 'expertId', 'expertName', 'status', 'urgency', 'category', 'crop', 'lang', 'district', 'upazila', 'consentScope', 'consentGrantedAt', 'consentExpiresAt', 'consentExpiresAtMs', 'consentRevoked', 'requestedAt', 'slaDueAt', 'slaDueAtMs', 'createdAt', 'updatedAt']) &&
             isStr(data.farmerId, 1, 128) &&
             isStr(data.farmerName, 0, 128) &&
             isStr(data.expertId, 1, 128) &&
             isStr(data.expertName, 0, 128) &&
             data.status == 'requested' &&
             data.urgency in ['emergency', 'urgent', 'general'] &&
             isStr(data.category, 1, 64) &&
             data.lang in ['bn', 'en'] &&
             isStr(data.district, 0, 64) &&
             isStr(data.upazila, 0, 64) &&
             data.consentScope is list && data.consentScope.size() <= 12 &&
             isTimestamp(data.consentGrantedAt) &&
             isTimestamp(data.consentExpiresAt) &&
             data.consentExpiresAtMs is number && data.consentExpiresAtMs > request.time.toMillis() &&
             data.consentRevoked == false &&
             isTimestamp(data.requestedAt) &&
             isTimestamp(data.slaDueAt) &&
             data.slaDueAtMs is number &&
             isTimestamp(data.createdAt) &&
             isTimestamp(data.updatedAt);
    }

    function isValidConsultationCase(data) {
      return data.keys().hasAll(['symptoms', 'consentSnapshot', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['symptoms', 'consentSnapshot', 'gps', 'createdAt', 'updatedAt']) &&
             isStr(data.symptoms, 1, 4000) &&
             data.consentSnapshot is map &&
             (!data.keys().hasAny(['gps']) ||
              (data.gps is map &&
               data.gps.lat is number && data.gps.lat >= -90 && data.gps.lat <= 90 &&
               data.gps.lng is number && data.gps.lng >= -180 && data.gps.lng <= 180)) &&
             isTimestamp(data.createdAt) &&
             isTimestamp(data.updatedAt);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderRole', 'type', 'createdAt']) &&
             isStr(data.senderId, 1, 128) &&
             data.senderRole in ['farmer', 'expert'] &&
             data.type in ['text', 'voice', 'photo', 'advisory', 'system'] &&
             isTimestamp(data.createdAt) &&
             (!data.keys().hasAny(['text']) || isStr(data.text, 1, 4000)) &&
             (!data.keys().hasAny(['audioUrl']) || (data.audioUrl is string && data.audioUrl.size() <= 420000)) &&
             (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 420000)) &&
             (!data.keys().hasAny(['advisory']) || data.advisory is map);
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['type', 'actorId', 'actorRole', 'createdAt']) &&
             isStr(data.type, 1, 64) &&
             isStr(data.actorId, 1, 128) &&
             data.actorRole in ['farmer', 'expert', 'system'] &&
             isTimestamp(data.createdAt);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['consultationId', 'expertId', 'farmerId', 'rating', 'createdAt']) &&
             isStr(data.consultationId, 1, 128) &&
             isStr(data.expertId, 1, 128) &&
             isStr(data.farmerId, 1, 128) &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             isTimestamp(data.createdAt);
    }

    // Public expert directory (sanitised fields only). Signed-in users may
    // browse and match; only the expert themself or an admin may write.
    match /experts_public/{expertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      // Only the admin approval flow may publish/verify an expert.
      allow create: if isAdmin() &&
                    isValidExpertPublic(incoming()) &&
                    isValidId(expertId);
      // An approved expert may pause/resume, edit their bio/photo; never
      // their own verification level or affiliation.
      allow update: if isSignedIn() &&
                    isValidId(expertId) &&
                    isValidExpertPublic(incoming()) &&
                    (
                      isAdmin() ||
                      (isOwner(expertId) &&
                       existing().status in ['active', 'paused'] &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bio', 'photoURL', 'responseTimeMins', 'updatedAt']) &&
                       incoming().status in ['active', 'paused'])
                    );
      allow delete: if isAdmin();
    }

    // Private expert details: phone, documents, availability, admin notes.
    match /experts_private/{expertId} {
      allow get: if isAdmin() || isOwner(expertId);
      allow list: if isAdmin();
      allow create, update: if (isAdmin() || isOwner(expertId)) && isValidExpertPrivate(incoming()) && isValidId(expertId);
      allow delete: if isAdmin();
    }

    match /expert_applications/{applicationId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.applicantId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.applicantId == request.auth.uid);
      allow create: if isSignedIn() &&
                    isValidExpertApplication(incoming()) &&
                    incoming().applicantId == request.auth.uid &&
                    incoming().status == 'pending' &&
                    isValidId(applicationId);
      allow update: if isAdmin() && isValidExpertApplication(incoming());
      allow delete: if isAdmin();
    }

    match /consultations/{consultationId} {
      allow get: if isAdmin() ||
                    (isSignedIn() &&
                     (resource.data.farmerId == request.auth.uid ||
                      (resource.data.expertId == request.auth.uid &&
                       resource.data.consentRevoked == false &&
                       resource.data.consentExpiresAtMs > request.time.toMillis())));
      allow list: if isAdmin() ||
                    (isSignedIn() &&
                     (resource.data.farmerId == request.auth.uid ||
                      (resource.data.expertId == request.auth.uid &&
                       resource.data.consentRevoked == false)));
      allow create: if isSignedIn() &&
                    isValidConsultation(incoming()) &&
                    incoming().farmerId == request.auth.uid &&
                    incoming().farmerId != incoming().expertId &&
                    isValidId(consultationId) &&
                    isActiveExpert(incoming().expertId);
      allow update: if isSignedIn() &&
                    isValidId(consultationId) &&
                    (
                      isAdmin() ||
                      // Farmer: cancel, revoke consent, rate/close, refresh counters.
                      // The status check is about the farmer's own status
                      // transitions. It must NOT gate the counter/consent
                      // updates above it, because `incoming().status` is the
                      // *current* status for those writes — and the current
                      // status is 'accepted' or 'awaiting_farmer' precisely
                      // when the farmer is expected to reply. Gating on it
                      // denied the farmer's message bookkeeping (and consent
                      // revocation) in exactly the states that matter.
                      (existing().farmerId == request.auth.uid &&
                       incoming().farmerId == existing().farmerId &&
                       incoming().expertId == existing().expertId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Status unchanged: counters, consent withdrawal,
                         // rating and close/cancel are always allowed.
                         incoming().status == existing().status ||
                         // Status moved: the farmer may only move to a
                         // status they own.
                         incoming().status in ['requested', 'cancelled', 'closed', 'resolved', 'in_progress']
                       ) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'consentRevoked', 'consentRevokedAt', 'farmerRating', 'farmerFeedback', 'closedAt', 'updatedAt', 'lastMessageAt', 'lastMessageSenderRole', 'lastFarmerMessageAt'])) ||
                      // Expert: accept, progress, resolve, refresh counters.
                      (existing().expertId == request.auth.uid &&
                       incoming().farmerId == existing().farmerId &&
                       incoming().expertId == existing().expertId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().status in ['requested', 'accepted', 'in_progress', 'awaiting_farmer', 'resolved', 'closed', 'escalated'] &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt', 'firstResponseAt', 'closedAt', 'outcome', 'expertNotes', 'updatedAt', 'lastMessageAt', 'lastMessageSenderRole', 'lastExpertMessageAt']))
                    );
      allow delete: if isAdmin();

      // Sensitive case details. Expert reads are gated by the parent's consent
      // state via isConsultationParticipant; the farmer owns create/update.
      match /case/{caseId} {
        allow get, list: if isConsultationParticipant(consultationId);
        allow create, update: if isConsultationFarmer(consultationId) &&
                      isValidConsultationCase(incoming()) &&
                      caseId == 'current';
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isConsultationParticipant(consultationId);
        allow create: if ((incoming().senderRole == 'farmer' && isConsultationFarmer(consultationId)) ||
                         (incoming().senderRole == 'expert' && isConsultationExpert(consultationId))) &&
                      isValidMessage(incoming()) &&
                      incoming().senderId == request.auth.uid &&
                      isValidId(messageId);
        allow update: if isConsultationParticipant(consultationId) &&
                      existing().senderId != request.auth.uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['readAt']);
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if isConsultationParticipant(consultationId);
        allow create: if ((incoming().actorRole == 'farmer' && isConsultationFarmer(consultationId)) ||
                         (incoming().actorRole == 'expert' && isConsultationExpert(consultationId))) &&
                      isValidEvent(incoming()) &&
                      incoming().actorId == request.auth.uid &&
                      isValidId(eventId);
        allow update, delete: if false;
      }
    }

    match /expert_reviews/{reviewId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.farmerId == request.auth.uid || resource.data.expertId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.farmerId == request.auth.uid || resource.data.expertId == request.auth.uid);
      allow create: if isSignedIn() &&
                    isValidReview(incoming()) &&
                    incoming().farmerId == request.auth.uid &&
                    incoming().consultationId == reviewId &&
                    get(/databases/$(database)/documents/consultations/$(incoming().consultationId)).data.farmerId == request.auth.uid &&
                    get(/databases/$(database)/documents/consultations/$(incoming().consultationId)).data.expertId == incoming().expertId &&
                    get(/databases/$(database)/documents/consultations/$(incoming().consultationId)).data.status in ['resolved', 'closed'] &&
                    isValidId(reviewId);
      allow update, delete: if isAdmin();
    }

    match /test/{testId} {
      allow read: if true;
    }

    // ===============================================================
    // Server-owned AI usage ledger
    //
    // The daily AI allowance used to be counted in the user's own profile
    // document, which the user can rewrite. It is now counted here, in
    // immutable event documents that only the account holder may append to.
    //
    //   users/{uid}/aiUsage/{eventId}
    //
    // Each event carries the day it belongs to as a `YYYYMMDD` number. The
    // rules compare it against `request.time` — the server clock — so the day
    // cannot be forged, rolled back or rolled forward. The events cannot be
    // updated or deleted, so the count only ever goes up: a caller can make
    // their own allowance smaller, never larger.
    // ===============================================================

    function serverDayNumber() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }

    match /users/{userId}/aiUsage/{eventId} {
      allow create: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(eventId) &&
                    request.resource.data.keys().hasOnly(['uid', 'day', 'kind', 'at']) &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.day == serverDayNumber() &&
                    request.resource.data.kind in ['text', 'audio'] &&
                    request.resource.data.at is number;
      // The owner is taken from the event itself, not from the path: a path
      // wildcard is not reliably bound while a collection is listed, and the
      // read query filters on `uid`, which the rules engine can then prove.
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ===============================================================
    // Server-recorded moderation events
    //   users/{uid}/moderationEvents/{eventId}
    //
    // Written by the AI proxy when the upstream refuses a request. The write
    // is made with the caller's own token, so the rules can prove the caller
    // is writing into their own subtree.
    //
    // The record is metadata about an event, not a transcript of it: who,
    // when, which surface, why, which model, how serious. The prompt text,
    // the image and the answer are never written here, so this ledger can
    // never become a second copy of what the farmer typed or photographed.
    //
    // The `category` key is optional — the upstream names a harm category only
    // sometimes — so it is allowed to be present or absent.
    //
    // Create-only. The events cannot be updated or deleted, by the farmer or
    // by an administrator, so the ledger cannot be rewritten.
    // ===============================================================

    match /users/{userId}/moderationEvents/{eventId} {
      allow create: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(eventId) &&
                    request.resource.data.keys().hasOnly(['uid', 'day', 'surface', 'reason', 'model', 'severity', 'at', 'category']) &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.day == serverDayNumber() &&
                    request.resource.data.surface in ['text', 'audio'] &&
                    request.resource.data.reason is string &&
                    request.resource.data.reason.size() > 0 &&
                    request.resource.data.reason.size() <= 64 &&
                    request.resource.data.model is string &&
                    request.resource.data.model.size() > 0 &&
                    request.resource.data.model.size() <= 64 &&
                    request.resource.data.severity in ['low', 'medium', 'high'] &&
                    request.resource.data.at is number &&
                    (!('category' in request.resource.data) ||
                     (request.resource.data.category is string &&
                      request.resource.data.category.size() <= 64));
      // The account holder can see their own refusals; an administrator can
      // review them. Nobody else can.
      allow read: if isOwner(userId) || isAdmin();
      allow update, delete: if false;
    }
  }
}
